APP_NAME=weatherflow-core
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OTEL_SERVICE_NAME=weatherflow-core

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://weatherflow:secret@mongodb_core:27017/weatherflow_core?authSource=admin
MONGODB_DATABASE=weatherflow_core

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

PROMETHEUS_REDIS_PREFIX=weatherflow_core
PROMETHEUS_REDIS_DB=0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=weatherflow
RABBITMQ_PASSWORD=secret
RABBITMQ_CONNECTION_TIMEOUT=3.0
RABBITMQ_READ_WRITE_TIMEOUT=3.0

QUEUE_STATIONS=station-events
QUEUE_RAW_MEASUREMENTS=raw-measurements
INGESTION_CRON="*/10 * * * *"

OWM_CONNECT_TIMEOUT=3
OWM_TIMEOUT=8
OWM_RETRIES=3
OWM_CACHE_TTL=600
OWM_BREAKER_THRESHOLD=5
OWM_BREAKER_RESET=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENWEATHER_API_KEY=
